%PreformattedPara
0 0 0 rg
BT 1 0 0 1 5 154.5 Tm /F4 7 Tf 8.5 TL (current_day = 30) Tj T* (records = [) Tj T* (    \("BK101", 25, 28, True\),) Tj T* (    \("BK102", 26, 0, False\),) Tj T* (    \("BK103", 29, 30, True\)) Tj T* (]) Tj T* (rate_per_day = 5) Tj T* (total_fines = 0) Tj T*  T* (for book_id, due_day, return_day, returned in records:) Tj T* (    actual_day = return_day if returned else current_day) Tj T* (    overdue = max\(0, actual_day - due_day\)) Tj T* (    fine = overdue * rate_per_day) Tj T* (    total_fines += fine) Tj T* (    status = "RETURNED" if returned else "OVERDUE - NOT RETURNED") Tj T* (    print\(f"{book_id}: overdue={overdue} days, ") Tj T* (          f"fine=Rs.{fine}, status={status}"\)) Tj T*  T* (print\("Total fines: Rs.", total_fines\)) Tj T* ET
