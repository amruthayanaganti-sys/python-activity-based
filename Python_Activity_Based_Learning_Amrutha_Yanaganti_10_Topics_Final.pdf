BT 1 0 0 1 5 214 Tm /F4 7 Tf 8.5 TL (branches = ["North", "South", "East"]) Tj T* (products = ["Laptop", "Tablet", "Phone"]) Tj T* (sales = [) Tj T* (    [12, 18, 25],) Tj T* (    [15, 14, 30],) Tj T* (    [10, 20, 22]) Tj T* (]) Tj T*  T* (if any\(value < 0 for row in sales for value in row\) or any\() Tj T* (        len\(row\) != len\(products\) for row in sales\):) Tj T* (    print\("Invalid sales matrix"\)) Tj T* (else:) Tj T* (    branch_totals = []) Tj T* (    for branch, row in zip\(branches, sales\):) Tj T* (        total = sum\(row\)) Tj T* (        branch_totals.append\(total\)) Tj T* (        print\(branch, "total sales:", total\)) Tj T*  T* (    product_totals = []) Tj T* (    for j, product in enumerate\(products\):) Tj T* (        total = sum\(row[j] for row in sales\)) Tj T* (        product_totals.append\(total\)) Tj T* (        print\(product, "total sales:", total\)) Tj T*  T* (    print\("Best branch:", branches[branch_totals.index\(max\(branch_totals\)\)]\)) Tj T* (    print\("Best-selling product:", products[product_totals.index\(max\(product_totals\)\)]\)) Tj T* ET
