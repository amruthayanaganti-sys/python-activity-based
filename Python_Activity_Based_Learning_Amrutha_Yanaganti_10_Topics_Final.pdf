%PreformattedPara
0 0 0 rg
BT 1 0 0 1 5 154.5 Tm /F4 7 Tf 8.5 TL (text = "Python is easy, and Python is useful.") Tj T* (clean_text = text.lower\(\)) Tj T* (for mark in ".,!?;:":) Tj T* (    clean_text = clean_text.replace\(mark, " "\)) Tj T*  T* (words = clean_text.split\(\)) Tj T* (counts = {}) Tj T*  T* (for word in words:) Tj T* (    counts[word] = counts.get\(word, 0\) + 1) Tj T*  T* (print\("Word frequencies:"\)) Tj T* (for word, count in counts.items\(\):) Tj T* (    print\(word, ":", count\)) Tj T*  T* (print\("Repeated words:"\)) Tj T* (for word, count in counts.items\(\):) Tj T* (    if count > 1:) Tj T* (        print\(word, "appears", count, "times"\)) Tj T* ET
